{
  // clod:tests — отдельная программа для тестов, и только ради типов Node.
  //
  // Тесты гоняет встроенный раннер Node, поэтому им нужны `node:test` и
  // `node:assert`. Подключить их в основной `tsconfig` нельзя ни списком
  // `types`, ни директивой `/// <reference>`: глобальные объявления действуют
  // на всю программу, а не на файл, и `setTimeout` во всём приложении начинает
  // возвращать `NodeJS.Timeout` вместо `number` — четыре компонента на этом
  // сразу перестают собираться.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["./src/**/*.test.ts"]
}
