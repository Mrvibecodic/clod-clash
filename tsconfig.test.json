{
  // clod:tests — отдельная программа для тестов, и только ради типов Node.
  //
  // Тесты гоняет встроенный раннер Node, поэтому им нужны `node:test` и
  // `node:assert`. Подключить их в основной `tsconfig` нельзя ни списком
  // `types`, ни директивой `/// <reference>`: глобальные объявления действуют
  // на всю программу, а не на файл, и `setTimeout` во всём приложении начинает
  // возвращать `NodeJS.Timeout` вместо `number` — четыре компонента на этом
  // сразу перестают собираться.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  // `extends` тащит и `exclude` из основного конфига, а там эти же файлы
  // исключены — без сброса программа получилась бы пустой.
  "exclude": [],
  // `IProfileItem` и соседи объявлены глобально в `global.d.ts` — без него
  // отдельная программа не знает типов, на которых стоит весь проект. Берём
  // только его: у остальных `.d.ts` есть импорты и они тянули бы за собой
  // типы i18next и React, которые тестам не нужны.
  "include": ["./src/**/*.test.ts", "./src/types/global.d.ts"]
}
